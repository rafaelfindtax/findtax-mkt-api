# API Configuration
PORT=3000
API_VERSION=/api/v1
MODE=production

# Database Configuration
# IMPORTANTE: use um host que NAO esteja atras do proxy da Cloudflare (nuvem laranja).
# A Cloudflare so faz proxy de HTTP/HTTPS; conexoes Postgres (5432) em dominio proxied
# resultam em ETIMEDOUT. Use um subdominio DNS-only (ex.: db.findtax.com.br) ou o host direto.
POSTGRES_HOST=db.findtax.com.br
POSTGRES_PORT=5432
POSTGRES_USER=your-postgres-user
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=your-database-name
POSTGRES_SCHEMA=public
POSTGRES_SSL=false